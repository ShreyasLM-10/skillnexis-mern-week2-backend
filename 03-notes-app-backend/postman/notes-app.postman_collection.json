    "name": "Week 2 - Notes App Backend",
    "description": "Run the 'Auth' folder first (Register or Login saves {{token}}). All requests in 'Notes' send it as a Bearer token via collection-level auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email every run so 'Register' never collides",
                  "pm.collectionVariables.set('email', `student${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.token);",
                  "pm.test('Token returned', () => pm.expect(json.data.token).to.be.a('string'));",
                  "pm.test('Password is never returned', () => pm.expect(json.data.user.password).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register same email again (expect 409)",
          "request": {
            "method": "POST",
            "header": [
