# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file - it is listed in .gitignore.

NODE_ENV=development
PORT=5002

# Local MongoDB:    mongodb://127.0.0.1:27017/notes_app
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notes_app
MONGO_URI=mongodb://127.0.0.1:27017/notes_app

# REQUIRED - at least 32 characters. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# bcrypt cost factor (10-14 is typical; higher = slower = harder to brute-force)
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of front-end origins allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Max requests per IP per 15 minutes: all /api routes / failed register+login attempts
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Set to 1 when deployed behind ONE reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0
