    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
