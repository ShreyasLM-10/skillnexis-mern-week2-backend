{
  "name": "todo-rest-api",
  "version": "1.0.0",
  "private": true,
  "description": "Week 2 / Assignment 1 - To-Do List REST API built with Node.js, Express 5, MongoDB and Mongoose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["nodejs", "express", "mongodb", "mongoose", "rest-api", "todo"],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
