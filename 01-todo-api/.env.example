# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file - it is listed in .gitignore.

NODE_ENV=development
PORT=5000

# Local MongoDB:    mongodb://127.0.0.1:27017/todo_api
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todo_api
MONGO_URI=mongodb://127.0.0.1:27017/todo_api

# Comma-separated list of front-end origins allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Max requests per IP per 15 minutes on /api routes
RATE_LIMIT_MAX=100

# Set to 1 when deployed behind ONE reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0
